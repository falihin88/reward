APP_NAME="AMYN Madrasah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://madrasah.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=info

# Database Configuration (standalone Coolify MariaDB instance)
# DB_HOST = the MariaDB resource's internal host: its UUID from the "Internal connection string"
DB_CONNECTION=mysql
DB_HOST=your-mariadb-uuid
DB_PORT=3306
DB_DATABASE=amyn_madrasah
DB_USERNAME=amyn_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_RANDOM_PASSWORD

# Enable TLS to the database (required if MariaDB has --require_secure_transport=ON)
# This path is the Alpine system CA bundle; the connection still works with a
# self-signed MariaDB cert because server verification is disabled.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

VITE_APP_NAME="${APP_NAME}"
